<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:background="#E2E8F0"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/dialogNaslov"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Naziv karte"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/dialogCijena"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cijena: 0.00 KM"
                android:textColor="#0284C7"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNESITE KOLIČINU"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/dialogEtKolicina"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Koliko karata želite?"
                android:inputType="number"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#F1F5F9"
                android:paddingLeft="16dp"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/dialogBtnPotvrdi"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#0284C7"
                android:text="Dodaj u korpu"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>