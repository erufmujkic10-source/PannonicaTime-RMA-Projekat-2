<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">


    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#E2E8F0"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/dialogSlika"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/slika_jezera" />
    </androidx.cardview.widget.CardView>


    <TextView
        android:id="@+id/dialogNaslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Naziv atrakcije"
        android:textColor="#1E293B"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />


    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F1F5F9"
        android:layout_marginBottom="14dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Kompleks Panonika"
            android:textColor="#475569"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp" />
    </androidx.cardview.widget.CardView>


    <TextView
        android:id="@+id/dialogOpis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ovdje ide detaljan i lijepo strukturiran opis lokacije koji objašnjava sve zanimljivosti."
        android:textColor="#475569"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="20dp" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/dialogBtnZatvori"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Zatvori"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:background="@android:drawable/btn_default"
        android:backgroundTint="#F1F5F9"/>

</LinearLayout>